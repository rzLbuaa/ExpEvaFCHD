{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "ExpEvaFCHD authored illustrative report",
  "description": "Synthetic authored output used to illustrate report structure and evidence attribution. It is not generated by the research system.",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "case_id",
    "status",
    "screening_label",
    "disease_entities",
    "disease_families",
    "retrieval",
    "risk",
    "report",
    "attribution",
    "workflow",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "illustrative-1"
    },
    "synthetic": {
      "const": true
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "illustrative",
        "insufficient_evidence",
        "rejected"
      ]
    },
    "screening_label": {
      "enum": [
        "positive",
        "negative",
        null
      ]
    },
    "disease_entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "disease_families": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "septal_defects",
          "great_vessels_aortic_arch",
          "venous_return_systemic_veins",
          "valves_outflow_tracts",
          "physiological_shunt_abnormalities",
          "other_structural_abnormalities",
          "cardiac_position_abnormalities"
        ]
      },
      "uniqueItems": true
    },
    "retrieval": {
      "type": "object",
      "required": [
        "case_ids",
        "low_similarity_fallback",
        "status"
      ],
      "properties": {
        "case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "low_similarity_fallback": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": [
        "raw_support",
        "mapped_probability",
        "mapping_status"
      ],
      "properties": {
        "raw_support": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mapped_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mapping_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": [
        "findings",
        "interpretation",
        "recommendation"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpretation": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement_id",
          "statement",
          "polarity",
          "measurement_fields",
          "retrieved_case_ids",
          "support_status"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string"
          },
          "polarity": {
            "type": "string"
          },
          "measurement_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "retrieved_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "support_status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "physician_review_required",
        "events"
      ],
      "properties": {
        "physician_review_required": {
          "const": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "computed_by_research_system",
        "description"
      ],
      "properties": {
        "kind": {
          "const": "authored_example"
        },
        "computed_by_research_system": {
          "const": false
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "insufficient_evidence",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "screening_label": {
            "type": "null"
          },
          "disease_entities": {
            "maxItems": 0
          },
          "disease_families": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "screening_label": {
            "const": "negative"
          }
        }
      },
      "then": {
        "properties": {
          "disease_entities": {
            "maxItems": 0
          },
          "disease_families": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
